{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "lunar:easter_petals",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "lunar:particles/textures/easter_petals.webp"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 1,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_disc": {
				"offset": [0, 2.5, 0],
				"radius": 1,
				"surface_only": true,
				"direction": [0, -1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 7
			},
			"minecraft:particle_initial_spin": {
				"rotation": "-45 + variable.particle_random_3*90"
			},
			"minecraft:particle_initial_speed": "math.random(0.4, 0.5)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 0.03, 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.15, 0.15],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 24,
					"texture_height": 24,
					"uv": ["math.round(variable.particle_random_1)*8", "math.round(variable.particle_random_2)*8"],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_motion_collision": {},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_age / variable.particle_lifetime",
					"gradient": {
						"0.0": "#00FFFFFF",
						"0.37": "#ffffffff",
						"0.88": "#ffffffff",
						"1.0": "#00FFFFFF"
					}
				}
			}
		}
	}
}