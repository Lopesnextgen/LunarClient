    <modelVersion>4.0.0</modelVersion>

    <groupId>com.moonsworth</groupId>
    <artifactId>lunar-client-deobf</artifactId>
    <version>1.8.9</version>
    <name>Lunar Client 1.8.9 (deobfuscated)</name>
    <description>Deobfuscated Lunar Client 1.8.9 sources merged into an MCP 1.8.9 workspace</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>17</release>
                    <proc>none</proc>
                    <debug>false</debug>
                    <fork>true</fork>
                    <meminitial>512m</meminitial>
                    <maxmem>2048m</maxmem>
                    <compilerArgs>
                        <arg>-g:none</arg>
                        <arg>-Xmaxerrs</arg>
                        <arg>100000</arg>
                    </compilerArgs>
                </configuration>
                <executions>
                    <!-- Phase 1 (runs first as the lifecycle default): the MCP
                         1.8.9 game sources compile on their own. A single
                         combined javac run overflows the constant pool of
                         several large vanilla classes and aborts codegen.
                         They are compiled at Java 8 level on purpose: Lunar's
                         Ichor transformer reads game classes with a bundled
                         ASM 5 that rejects anything newer than class file 52
                         (Java 8). Mixin classes are loaded by the JVM, not
                         read through that ASM, so only game classes need it. -->
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <release>8</release>
                            <includes>
                                <include>net/minecraft/**</include>
                            </includes>
                        </configuration>
                    </execution>
                    <!-- Phase 2: the deobfuscated Lunar client sources. -->
                    <execution>
                        <id>compile-lunar</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>com/moonsworth/**</include>
                            </includes>
                            <excludes>
                                <exclude>com/moonsworth/lunar/forge/lib/**</exclude>
                                <exclude>com/moonsworth/lunar/OHOOORICRHIIIIRHCICICOCHROICRC/HRICOROOOCCOCOROCRHHCRRIRCOICO$1.java</exclude>
                                <exclude>com/moonsworth/lunar/OHOOORICRHIIIIRHCICICOCHROICRC/HRICOROOOCCOCOROCRHHCRRIRCOICO$2.java</exclude>
                            </excludes>
                            <compilerArgs>
                                <arg>-g:none</arg>
                                <arg>-Xmaxerrs</arg>
                                <arg>100000</arg>
                                <arg>-XDshould-stop.ifError=GENERATE</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>create-my-bundle</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>tools/assembly-jar-with-dependencies.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

