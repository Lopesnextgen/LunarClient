        <!-- Lunar's bundled protocol API (generated protobuf messages + Apollo
             mod interfaces). Kept as a compiled library per the repo's own
             convention (STATUS.md: "com/lunarclient/* is bundled compiled");
             the deobfuscated client code lives in src/main/java. -->
        <dependency>
            <groupId>lunar</groupId>
            <artifactId>lunarclient-protocol</artifactId>
            <version>1.8.9</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/lunarclient-protocol.jar</systemPath>
        </dependency>

        <!-- Third-party libraries that Lunar's reference jar bundles (Mixin,
             kyori adventure, protobuf, kotlin, jctools, ...). Extracted from
             libs/lunar-renamed-classes.jar by tools/extract_bundled_deps.py
             so the build no longer needs the Lunar classes jar itself; each
             package can be replaced by its Maven coordinate over time.
             Listed last so Maven-managed versions win for shared packages. -->
        <dependency>
            <groupId>lunar</groupId>
            <artifactId>bundled-libs</artifactId>
            <version>1.8.9</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/lunar-bundled-libs.jar</systemPath>
