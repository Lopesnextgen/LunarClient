            "minecraft:particle_initial_speed": 0.0,
            "minecraft:particle_motion_dynamic": {
                "linear_acceleration": [
                    "math.random(-1.0, 1.0) * 0.01",
                    "math.random(-1.0, 1.0) * 0.01",
                    "math.random(-1.0, 1.0) * 0.01 + (variable.emitter_age > 3.0 ? 1 * (variable.particle_random_3 * 0.25 + 0.75) + (variable.emitter_age - 2.0) : 0.0)"
                ],
                "linear_drag_coefficient": 0
