{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "lunar:wand_spell",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles"
			}
		},
		"curves": {
			"variable.s": {
				"type": "linear",
				"input": "variable.particle_age",
				"horizontal_range": "variable.particle_lifetime",
				"nodes": [0, 1, 0]
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.threshold = 0.5;"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": "variable.emitter_age < variable.threshold ? 75 : 350",
				"max_particles": 1000
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1,
				"sleep_time": 2
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, 0, "math.clamp(variable.emitter_age * 5, 0, 3)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1
			},
			"minecraft:particle_initial_spin": {
				"rotation_rate": 250
			},
			"minecraft:particle_initial_speed": "variable.emitter_age < variable.threshold ? 0 : 1",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 0, 1],
				"linear_drag_coefficient": 0.1,
				"rotation_acceleration": 100
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(0.05 + variable.particle_random_1 * 0.05) * variable.s", "(0.05 + variable.particle_random_1 * 0.05) * variable.s"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": ["math.floor(variable.particle_random_3 * 6) * 8", 80],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_random_4",
					"gradient": {
						"0.0": "#00FFA5",
						"1.0": "#90FF00"
					}
				}
			}
		}
	}
}