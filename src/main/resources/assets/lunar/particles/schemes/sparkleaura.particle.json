{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "lunar:sparkleaura",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "lunar:particles/textures/sparkleaura.webp"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 15,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_box": {
				"offset": [0, 0.5, 0],
				"half_dimensions": [0.5, 0.5, 0.5],
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 2
			},
			"minecraft:particle_initial_spin": {
				"rotation": "variable.particle_random_1 *360"
			},
			"minecraft:particle_initial_speed": 0.25,
			"minecraft:particle_motion_dynamic": {
				"rotation_acceleration": 1
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.15, 0.15],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [
						"math.round(variable.particle_random_1,0,1)*8",
						"math.round(variable.emitter_random_1,0,1)*8"
					],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_age / variable.particle_lifetime",
					"gradient": {
						"0.0": "#00FFFF",
						"0.32": "#CFD9FB",
						"0.39": "#FF4FDC",
						"0.51": "#ffffff",
						"0.78": "#FFFFFF",
						"1.0": "#00FFFF"
					}
				}
			}
		}
	}
}
