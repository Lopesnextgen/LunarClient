{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "lunar:zen_aura",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particle/particles"
			}
		},
		"curves": {
			"variable.s": {
				"type": "catmull_rom",
				"input": "variable.particle_age",
				"horizontal_range": "variable.particle_lifetime",
				"nodes": [0, 0, 1, 0, 1, 0, 0]
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 50,
				"max_particles": 1000
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 4
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 4
			},
			"minecraft:particle_initial_spin": {
				"rotation_rate": 100
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": ["math.cos((variable.particle_random_3 * 2 - variable.particle_age) * 90) * (0.2 + variable.particle_random_2 + math.sin(variable.particle_age * 180) * 0.2)", "math.sin(variable.particle_age * 180) * 0.05", "math.sin((variable.particle_random_3 * 2 - variable.particle_age) * 90) * (0.2 + variable.particle_random_2 + math.sin(variable.particle_age * 180) * 0.2)"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.08 * variable.s", "0.08 * variable.s"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [32, 88],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "math.mod(v.particle_age / v.particle_lifetime + variable.particle_random_4, 1)",
					"gradient": {
						"0.0": "#FFDA00",
						"0.48": "#FF6D00",
						"1.0": "#FFDA00"
					}
				}
			}
		}
	}
}